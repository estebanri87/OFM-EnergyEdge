<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <Parameters>
              <!-- Kanal-Beschreibung -->
              <Parameter Id="%AID%_P-%TT%%CC%000" Name="Channel%C%Name" ParameterType="%AID%_PT-Text40Byte" Text="Beschreibung" Value="" />

              <!-- Kategorie (Byte 0) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%001" Name="CH%C%Category" ParameterType="%AID%_PT-EEXCategory" Offset="0" BitOffset="0" Text="Kategorie" Value="0" />
              </Union>
              <!-- Kategorie auf dem Kanal-Tab (TypeSelect): kein Speicher, nur in der ETS -->
              <Parameter Id="%AID%_P-%TT%%CC%011" Name="CH%C%CategorySelect" ParameterType="%AID%_PT-EEXCategorySelect" Text="Kategorie" Value="1" />

              <!-- Modbus-Profil (Verbraucher) (Byte 1) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="1" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%002" Name="CH%C%ConsumerProfile" ParameterType="%AID%_PT-EEXConsumerProfile" Offset="0" BitOffset="0" Text="Modbus-Profil" Value="0" />
              </Union>

              <!-- Modbus Unit-ID (Byte 2) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="2" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%003" Name="CH%C%UnitId" ParameterType="%AID%_PT-EEXUnitId" Offset="0" BitOffset="0" Text="Modbus Unit-ID" Value="1" />
              </Union>

              <!-- Vorzeichen invertieren (Byte 3) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="3" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%004" Name="CH%C%Invert" ParameterType="%AID%_PT-EEXYesNo" Offset="0" BitOffset="0" Text="Vorzeichen invertieren" Value="0" />
              </Union>

              <!-- Watchdog-Timeout in Sekunden (Byte 4-5) -->
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="4" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%005" Name="CH%C%Timeout" ParameterType="%AID%_PT-EEXTimeout" Offset="0" BitOffset="0" Text="Timeout (0 = aus)" SuffixText=" s" Value="0" />
              </Union>

              <!-- Skalierungsfaktor in Promille (1000 = 1.0) (Byte 6-7) -->
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="6" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%006" Name="CH%C%Scale" ParameterType="%AID%_PT-EEXScale" Offset="0" BitOffset="0" Text="Skalierung (Promille, 1000 = 1,0)" Value="1000" />
              </Union>

              <!-- SolarEdge Modell (Byte 8-39, 32 Zeichen) -->
              <Union SizeInBit="256">
                <Memory CodeSegment="%MID%" Offset="8" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%007" Name="CH%C%Model" ParameterType="%AID%_PT-EEXString32" Offset="0" BitOffset="0" Text="SunSpec Modell" Value="SE3000H-RW000BNN4" />
              </Union>

              <!-- SolarEdge Seriennummer (Byte 40-71, 32 Zeichen) -->
              <Union SizeInBit="256">
                <Memory CodeSegment="%MID%" Offset="40" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%008" Name="CH%C%Serial" ParameterType="%AID%_PT-EEXString32" Offset="0" BitOffset="0" Text="SunSpec Seriennummer" Value="7E123456" />
              </Union>

              <!-- Virtual Switch _id (Byte 72-103, 32 Zeichen) -->
              <Union SizeInBit="256">
                <Memory CodeSegment="%MID%" Offset="72" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%009" Name="CH%C%DeviceId" ParameterType="%AID%_PT-EEXString32" Offset="0" BitOffset="0" Text="Virtual Switch ID (_id)" Value="" />
              </Union>

              <!-- KO 'Letzte Abfrage' verwenden (Byte 104) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="104" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%010" Name="CH%C%ShowLastQuery" ParameterType="%AID%_PT-EEXYesNo" Offset="0" BitOffset="0" Text="Status KO 'Letzte Abfrage' verwenden" Value="1" />
              </Union>
            </Parameters>

            <ParameterRefs>
              <ParameterRef Id="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001"  RefId="%AID%_P-%TT%%CC%000" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_UP-%TT%%CC%001" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_UP-%TT%%CC%002" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_UP-%TT%%CC%003" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_UP-%TT%%CC%004" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" RefId="%AID%_UP-%TT%%CC%005" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" RefId="%AID%_UP-%TT%%CC%006" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%007_R-%TT%%CC%00701" RefId="%AID%_UP-%TT%%CC%007" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" RefId="%AID%_UP-%TT%%CC%008" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%009_R-%TT%%CC%00901" RefId="%AID%_UP-%TT%%CC%009" />
              <ParameterRef Id="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001" RefId="%AID%_UP-%TT%%CC%010" />
              <ParameterRef Id="%AID%_P-%TT%%CC%011_R-%TT%%CC%01101" RefId="%AID%_P-%TT%%CC%011" />
            </ParameterRefs>

            <ParameterCalculations>
              <!-- Kategorie zwischen Kanalauswahl und Kanal-Tab synchronisieren -->
              <ParameterCalculation Id="%AID%_PC-%TT%%CC%001" Language="JavaScript" Name="SyncType%CC%" RLTransformationFunc="BASE_SyncChannelType" LRTransformationFunc="BASE_SyncChannelType">
                <LParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%011_R-%TT%%CC%01101" AliasName="TypeValue" />
                </LParameters>
                <RParameters>
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" AliasName="TypeValue" />
                </RParameters>
              </ParameterCalculation>
            </ParameterCalculations>

            <ComObjectTable>
              <!-- KO 0: Wirkleistung (Eingang vom KNX-Bus, DPT 14.056 W) - Zähler-Kategorien -->
              <ComObject Id="%AID%_O-%TT%%CC%000" Number="%K0%" Name="CH%C%Wirkleistung" Text="" FunctionText="" ObjectSize="4 Bytes" DatapointType="DPST-14-56" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Enabled" ReadOnInitFlag="Enabled" />
              <!-- KO 1: Schaltausgang (Ausgang an KNX-Aktor, DPT 1.001) - Schalter/Virtual Switch -->
              <ComObject Id="%AID%_O-%TT%%CC%001" Number="%K1%" Name="CH%C%Schaltausgang" Text="" FunctionText="" ObjectSize="1 Bit" DatapointType="DPST-1-1" ReadFlag="Disabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- KO 2: Letzte Modbus-Abfrage dieses Kanals (Ausgang, DPT 19.001) - Zähler-Kategorien -->
              <ComObject Id="%AID%_O-%TT%%CC%002" Number="%K2%" Name="CH%C%LetzteAbfrage" Text="" FunctionText="" ObjectSize="8 Bytes" DatapointType="DPST-19-1" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- KO 3/4: Energie Bezug/Einspeisung (Eingang vom KNX-Bus, DPT 13.013 kWh) - nur Smart Meter.
                   Der EX 1 summiert je Wert zwei Register: Bezug 4131+4147, Einspeisung 4173+4189
                   (am Gerät per eexprobe ermittelt). Wir schreiben den Wert auf das jeweils erste. -->
              <ComObject Id="%AID%_O-%TT%%CC%003" Number="%K3%" Name="CH%C%Bezug"       Text="" FunctionText="" ObjectSize="4 Bytes" DatapointType="DPST-13-13" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Enabled" ReadOnInitFlag="Enabled" />
              <ComObject Id="%AID%_O-%TT%%CC%004" Number="%K4%" Name="CH%C%Einspeisung" Text="" FunctionText="" ObjectSize="4 Bytes" DatapointType="DPST-13-13" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Enabled" ReadOnInitFlag="Enabled" />
            </ComObjectTable>

            <ComObjectRefs>
              <!-- Wirkleistung-Refs je Zähler-Kategorie (gleiche KO-Nummer), damit die Objektfunktion die Kategorie widerspiegelt. -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_O-%TT%%CC%000" Text="{{0:Energiemessung %C%}}: Wirkleistung" FunctionText="Energiemessung %C%: Eingang, Wirkleistung (W)" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00002" RefId="%AID%_O-%TT%%CC%000" Text="{{0:Smart Meter %C%}}: Wirkleistung"    FunctionText="Smart Meter %C%: Eingang, Wirkleistung (W)"    TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00003" RefId="%AID%_O-%TT%%CC%000" Text="{{0:Wechselrichter %C%}}: Wirkleistung" FunctionText="Wechselrichter %C%: Eingang, Wirkleistung (W)" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <!-- Schaltausgang-Ref (Schalter/Virtual Switch) -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_O-%TT%%CC%001" Text="{{0:Schalter %C%}}: Schaltausgang" FunctionText="Schalter %C%: Ausgang, Schalten" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <!-- Letzte-Abfrage-Refs je Zähler-Kategorie (gleiche KO-Nummer) -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_O-%TT%%CC%002" Text="{{0:Energiemessung %C%}}: Letzte Abfrage" FunctionText="Energiemessung %C%: Ausgang, Letzte Modbus-Abfrage" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%002_R-%TT%%CC%00202" RefId="%AID%_O-%TT%%CC%002" Text="{{0:Smart Meter %C%}}: Letzte Abfrage"    FunctionText="Smart Meter %C%: Ausgang, Letzte Modbus-Abfrage"    TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%002_R-%TT%%CC%00203" RefId="%AID%_O-%TT%%CC%002" Text="{{0:Wechselrichter %C%}}: Letzte Abfrage" FunctionText="Wechselrichter %C%: Ausgang, Letzte Modbus-Abfrage" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <!-- Energie-Refs (nur Smart Meter) -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_O-%TT%%CC%003" Text="{{0:Smart Meter %C%}}: Bezug"       FunctionText="Smart Meter %C%: Eingang, Bezug (kWh)"       TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
              <ComObjectRef Id="%AID%_O-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_O-%TT%%CC%004" Text="{{0:Smart Meter %C%}}: Einspeisung" FunctionText="Smart Meter %C%: Eingang, Einspeisung (kWh)" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" />
            </ComObjectRefs>
          </Static>

          <Dynamic>
            <ChannelIndependentBlock>
              <!-- Zeile der Kanalauswahl-Tabelle (eine einzeilige Tabelle je Kanal) -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Kanal %C%" />
                  <!-- Haupttyp (mit Speicher, mit "Deaktiviert") - nur hier wird aktiviert/deaktiviert -->
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" Cell="1,2" HelpContext="EEX-Kategorie" />
                  <!-- Beschreibung bleibt auch bei Deaktiviert sichtbar -->
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <!-- Kanal-Tab (nur sichtbar, wenn eine Kategorie gewählt ist) -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
                <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                  <when test="&gt;0">
                  <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%EEX" Text="Kanal %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Icon="meter-electric-outline" ShowInComObjectTree="true">

                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanaldefinition" UIHint="Headline" />
                    <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" HelpContext="BASE-ChannelName" />
                    <!-- Kategorie (ohne "Deaktiviert", synchron zur Kanalauswahl) -->
                    <ParameterRefRef RefId="%AID%_P-%TT%%CC%011_R-%TT%%CC%01101" HelpContext="EEX-Kategorie" />

                    <!-- Kategorie-abhängige Hinweise / Profil -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <!-- Modbus-Profil nur bei Verbraucher-Zählern (Energiemessung, Smart Meter) -->
                      <when test="&lt;3">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" HelpContext="EEX-Modbus-Profil" />
                      </when>
                      <!-- Schalter/Virtual Switch: Hinweis + _id -->
                      <when test="=3">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Schalter/Virtual Switch: der Zustand wird über die lokale EX 1-API (Virtual Switch) gelesen und schaltet einen KNX-Aktorkanal. Die PV-Überschuss-Logik liegt im EX 1." UIHint="Information" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%009_R-%TT%%CC%00901" HelpContext="EEX-Virtual-Switch-ID" />
                      </when>
                      <!-- Wechselrichter: SolarEdge -->
                      <when test="=4">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Profil: SolarEdge (SunSpec) – emuliert einen einphasigen Wechselrichter." UIHint="Information" />
                      </when>
                    </choose>

                    <!-- Modbus (nur Zähler-Kategorien, nicht Schalter) -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="!=3">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Modbus" UIHint="Headline" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="EEX-Unit-ID" />
                      </when>
                    </choose>
                    <!-- Hinweis Sub-Meter/ZEV nur bei Smart Meter -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="=2">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Als 'Sub-Meter' / ZEV im EX 1 einbinden: dort gibt es kein Geräte-ID-Feld, der EX 1 fragt immer Unit-ID 1 ab und unterscheidet nur über die IP (ein Sub-Meter pro IP). Für diesen Fall Unit-ID 1 setzen." UIHint="Information" />
                      </when>
                    </choose>
                    <!-- SDM630 nutzt fest Unit-ID 1 -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201">
                      <when test="=1">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="SDM630 nutzt im EX 1 fest Unit-ID 1 (nur ein Gerät pro IP)." UIHint="Information" />
                      </when>
                    </choose>

                    <!-- SunSpec-Identität nur bei Wechselrichter -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="=4">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="SunSpec-Identität" UIHint="Headline" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%007_R-%TT%%CC%00701" HelpContext="EEX-SolarEdge-Identitaet" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" HelpContext="EEX-SolarEdge-Identitaet" />
                      </when>
                    </choose>

                    <!-- Verhalten (nur Zähler-Kategorien) -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="!=3">
                        <ParameterSeparator Id="%AID%_PS-nnn" Text="Verhalten" UIHint="Headline" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="EEX-Watchdog" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="EEX-Aufbereitung" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" HelpContext="EEX-Aufbereitung" />
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001" HelpContext="EEX-Letzte-Abfrage" />
                      </when>
                    </choose>

                    <!-- KO: Zähler -> Wirkleistung (Objektfunktion je Kategorie), Schalter -> Schaltausgang -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="=1"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" /></when>
                      <when test="=2">
                        <ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00002" />
                        <ComObjectRefRef RefId="%AID%_O-%TT%%CC%003_R-%TT%%CC%00301" />
                        <ComObjectRefRef RefId="%AID%_O-%TT%%CC%004_R-%TT%%CC%00401" />
                      </when>
                      <when test="=3"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%001_R-%TT%%CC%00101" /></when>
                      <when test="=4"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00003" /></when>
                    </choose>
                    <!-- Letzte-Abfrage-KO (nur Zähler-Kategorien, per Checkbox ein-/ausblendbar, Objektfunktion je Kategorie) -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001">
                      <when test="=1">
                        <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                          <when test="=1"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%002_R-%TT%%CC%00201" /></when>
                          <when test="=2"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%002_R-%TT%%CC%00202" /></when>
                          <when test="=4"><ComObjectRefRef RefId="%AID%_O-%TT%%CC%002_R-%TT%%CC%00203" /></when>
                        </choose>
                      </when>
                    </choose>

                  </ParameterBlock>
                  </when>
                </choose>
              </ParameterBlock>
            </ChannelIndependentBlock>
          </Dynamic>

        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
